# Spotisub configuration.
# Copy this file to .env next to docker-compose.yml and fill in the values.
# Everything is an environment variable; the full reference is at
# https://blastbeng.github.io/spotisub/configuration/environment-variables/

# --- Application -----------------------------------------------------------
# Optional: set a fixed secret key so sessions survive restarts.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(64))"
# If not set, a key is auto-generated once and stored in cache/secret_key.
SECRET_KEY=

# --- Spotify ---------------------------------------------------------------
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# The redirect URI below must be added to that app, character for character.
SPOTIPY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SPOTIPY_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5183/callback

# --- Subsonic / Navidrome --------------------------------------------------
SUBSONIC_API_HOST=http://127.0.0.1
# Optional: leave SUBSONIC_API_PORT empty to use 443 for https or 80 for http. Will work automatically based on SUBSONIC_API_HOST variable.
SUBSONIC_API_PORT=4533
SUBSONIC_API_USER=user
SUBSONIC_API_PASS=pass
SUBSONIC_API_VERIFY_SSL=1
# Optional: path prefix of the server, for example /navidrome
# SUBSONIC_API_BASE_URL=

# --- Generation ------------------------------------------------------------
# Prefix of every playlist Spotisub writes on the server.
# PLAYLIST_PREFIX=Spotisub -
# Maximum number of tracks per generated playlist.
ITEMS_PER_PLAYLIST=1000
# How many of your Spotify playlists to import.
NUM_USER_PLAYLISTS=5
# Fall back to a fuzzy title/artist comparison when the MBID lookup fails.
# See https://blastbeng.github.io/spotisub/guide/matching/
TEXT_COMAPRE_MATCHING_ENABLED=0
# Words that exclude a candidate match, but only in the text comparison above.
# EXCLUDED_WORDS=acoustic,instrumental,demo
# Create a "Top Tracks" playlist for every artist in your library.
ARTIST_PLAYLIST_ENABLED=0

# --- Schedule (hours between runs; 0 disables the job) ---------------------
# One random Spotify playlist is imported per interval.
PLAYLIST_GEN_SCHED=3
SAVED_GEN_SCHED=2
ARTIST_TOP_GEN_SCHED=1
# Recommendations were removed from the Spotify API in December 2024.
# ARTIST_GEN_SCHED=1
# RECOMMEND_GEN_SCHED=4

# --- Logging ---------------------------------------------------------------
# Possible log levels: 10=DEBUG, 20=INFO (default), 30=WARNING, 40=ERROR, 50=CRITICAL
LOG_LEVEL=20

# --- spotdl: download missing tracks --------------------------------------
# Requires Spotify Premium. See https://blastbeng.github.io/spotisub/integrations/spotdl/
# SPOTDL_ENABLED=0
# SPOTDL_FORMAT=/music/{artist}/{artists} - {album} ({year}) - {track-number} - {title}.{output-ext}

# --- Lidarr: only download artists you already monitor --------------------
# See https://blastbeng.github.io/spotisub/integrations/lidarr/
# LIDARR_ENABLED=0
# LIDARR_IP=127.0.0.1
# LIDARR_PORT=8686
# LIDARR_TOKEN=
# LIDARR_BASE_API_PATH=
# LIDARR_USE_SSL=0
